" ─── Sauvegarder / quitter ────────────────────────────────────────────────
nnoremap <silent> <C-s> :update<CR>
inoremap <silent> <C-s> <Esc>:update<CR>a
vnoremap <silent> <C-s> <Esc>:update<CR>
" ≈ LazyVim : quitter tout / sauver tout (commentaire hors du mapping : le "
" signe " en fin de mapping ferait partie du raccourci !)
nnoremap <silent> <leader>qq :confirm qa<CR>
nnoremap <silent> <leader>ww :wa<CR>

" ─── Buffers ≈ LazyVim (barre bufferline + <S-h>/<S-l>) ──────────────────
nnoremap <silent> <S-h> :bprevious<CR>
nnoremap <silent> <S-l> :bnext<CR>
nnoremap <silent> [b    :bprevious<CR>
nnoremap <silent> ]b    :bnext<CR>
nnoremap <silent> [B    :bfirst<CR>
nnoremap <silent> ]B    :blast<CR>
nnoremap <silent> <leader>bd :bdelete<CR>
" garder uniquement le buffer actif
nnoremap <silent> <leader>bo :%bdelete<BAR>edit#<BAR>bd#<CR>

" ─── Fenêtres ─────────────────────────────────────────────────────────────
" ≈ LazyVim : Ctrl+hjkl pour naviguer
nnoremap <silent> <C-h> <C-w>h
nnoremap <silent> <C-j> <C-w>j
nnoremap <silent> <C-k> <C-w>k
nnoremap <silent> <C-l> <C-w>l

" Fenêtres via <leader>w : mappings EXPLICITES (et non un nmap <leader>w
" <C-w> global) pour que which-key affiche un vrai sous-menu avec des
" descriptions au lieu d'être écrasé par la feuille native <C-w>
nnoremap <silent> <leader>wh <C-w>h
nnoremap <silent> <leader>wj <C-w>j
nnoremap <silent> <leader>wk <C-w>k
nnoremap <silent> <leader>wl <C-w>l
nnoremap <silent> <leader>wv :vsplit<CR>
nnoremap <silent> <leader>ws :split<CR>
nnoremap <silent> <leader>wd :close<CR>
nnoremap <silent> <leader>wo :only<CR>
nnoremap <silent> <leader>w= <C-w>=
" <Bar> est la forme protégée du pipe : un | nu terminerait la commande
" :nnoremap et exécuterait ":vsplit<CR>" comme une commande séparée !
nnoremap <silent> <leader><Bar> :vsplit<CR>
nnoremap <silent> <leader>- :split<CR>

" ─── Splits de fichiers (≈ LazyVim <leader>ed / <leader>ef) ──────────────
nnoremap <silent> <leader>ev :vsplit<CR>:edit<Space>
nnoremap <silent> <leader>es :split<CR>:edit<Space>

" ─── Déplacement écran centré (≈ LazyVim) ─────────────────────────────────
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz
nnoremap n nzzzv
nnoremap N Nzzzv

" ─── Indentation qui reste en mode visuel ─────────────────────────────────
vnoremap < <gv
vnoremap > >gv

" ─── Déplacer lignes / sélection (Alt+j / Alt+k) ─────────────────────────
nnoremap <silent> <A-j> :m .+1<CR>==
nnoremap <silent> <A-k> :m .-2<CR>==
inoremap <silent> <A-j> <Esc>:m .+1<CR>==gi
inoremap <silent> <A-k> <Esc>:m .-2<CR>==gi
vnoremap <silent> <A-j> :m '>+1<CR>gv=gv
vnoremap <silent> <A-k> :m '<-2<CR>gv=gv

" ─── Recherche ────────────────────────────────────────────────────────────
" / et ? restent en « magic » par défaut : le préfixe \v rendait les
" caractères = ? # < > & spéciaux (E64 sur "/=>" par exemple).
" Si tu veux le very magic à la demande : nnoremap / /\v
nnoremap <silent> <Esc><Esc> :let @/=''<CR>
" conservé de ta config : vider la recherche
" (l'ancien <leader><space> « clear search » est remplacé par <Esc><Esc>
"  ci-dessus : <leader><leader> doit rester libre pour le switch de buffers
"  fzf, comme dans LazyVim)

" * fonctionne sur la sélection visuelle (vim-visualstar)
" Remplacer yank : gra{motion} (≈ LazyVim gr{motion})

" ─── Grep projet ≈ telescope live_grep ───────────────────────────────────
" Grep depuis la racine git du fichier (fallback : son dossier) — JAMAIS
" depuis le cwd, sinon "vim ~/unfichier" + <leader>sw crawl tout ~ !
" Grep EXACT (quickfix) — l'équivalent flou est <leader>sw ci-dessous
function! s:ProjectGrep(args) abort
  let l:git = systemlist('git -C ' . shellescape(expand('%:p:h')) . ' rev-parse --show-toplevel')
  let l:root = (v:shell_error || empty(l:git)) ? expand('%:p:h') : l:git[0]
  let l:cwd = getcwd()
  execute 'lcd ' . fnameescape(l:root)
  try
    execute 'grep ' . a:args
  finally
    execute 'lcd ' . fnameescape(l:cwd)
  endtry
  copen
endfunction
" mots sous le curseur dans le quickfix (grep exact)
nnoremap <silent> <leader>sq :call <SID>ProjectGrep(expand('<cword>'))<CR>
" Recherche floue live ≈ telescope live_grep (LazyVim <leader>sw)
command! -bang -nargs=* RgLive
      \ call fzf#vim#grep(
      \   'rg --column --line-number --no-heading --color=always --smart-case ' .
      \   '--glob "!node_modules" --glob "!.git" --glob "!dist" --glob "!build" --glob "!target" -- ' .
      \   shellescape(<q-args>), 1,
      \   fzf#vim#with_preview('right:50%'), <bang>0)
" mot sous le curseur, prérempli (éditable en live)
nnoremap <silent> <leader>sw :execute 'RgLive ' . expand('<cword>')<CR>
nnoremap <silent> <leader>sW :execute 'RgLive ' . expand('<cWORD>')<CR>
" motif libre, flou, en live
nnoremap <leader>/ :RgLive<CR>

" <leader>xx → toggle quickfix (≈ Trouble de LazyVim), en pur VimScript
function! s:ToggleQuickfix() abort
  for l:win in range(1, winnr('$'))
    if getwinvar(l:win, '&buftype') ==# 'quickfix'
      cclose | return
    endif
  endfor
  copen
endfunction
nnoremap <silent> <leader>xx :call <SID>ToggleQuickfix()<CR>
nnoremap <silent> <leader>xq :cclose<CR>

" ─── Fuzzy finder (fzf) ≈ Telescope de LazyVim ──────────────────────────
nnoremap <silent> <C-p>           :Files<CR>       " fichiers du projet
nnoremap <silent> <leader>ff      :Files<CR>
nnoremap <silent> <leader><leader> :Buffers<CR>    " switch de buffer flou
nnoremap <silent> <leader>fb      :Buffers<CR>
