" ═══════════════════════════════════════════════════════════════════════════
"  AUTOCMDS — comportements du core LazyVim
" ═══════════════════════════════════════════════════════════════════════════

" Répertoire undo
augroup vimrc_undodir
  autocmd!
  autocmd BufWritePre * call mkdir(expand('~/.vim/undodir'), 'p')
augroup END

" Recharger un fichier modifié à l'extérieur (≈ LazyVim autoread group)
augroup vimrc_autoread
  autocmd!
  autocmd FocusGained,BufEnter * checktime
augroup END

" Revenir à la dernière position d'édition
augroup vimrc_restore_pos
  autocmd!
  autocmd BufReadPost *
        \ if line("'\"") >= 1 && line("'\"") <= line("$") && &ft !~# 'commit' |
        \   execute 'normal! g`"' |
        \ endif
augroup END

" Lancer :checktime au focus (déjà couvert) + resize auto des splits
augroup vimrc_resize
  autocmd!
  autocmd VimResized * wincmd =
augroup END

" Fermer NERDTree si c'est la dernière fenêtre (comportement type LazyVim)
augroup vimrc_nerdtree
  autocmd!
  autocmd BufEnter *
        \ if (winnr("$") == 1 && exists("b:NERDTree") && b:NERDTree.isTabTree())
        \|   q | endif
augroup END

