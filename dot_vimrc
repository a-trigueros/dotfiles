" ============================================================================
"  ~/.vimrc — expérience « LazyVim » sous Vim 9.1 (macOS)
"  Sauvegarde de l'ancienne config : ~/.vimrc.backup-20260930
"
"  Après édition, lance :  :PlugInstall
"
"  ── Raccourcis principaux (référence rapide) ──────────────────────────────
"    <leader> = Espace
"    <leader>e / <leader>E    NERDTree toggle / révéler le fichier courant
"    <leader>w                = Ctrl-w (toutes les commandes fenêtres)
"    <leader>| / <leader>-    split vertical / horizontal
"    <C-h/j/k/l>              naviguer entre les fenêtres
"    [b / ]b                  buffer précédent / suivant
"    <leader><leader>         buffers (fzf, flou)
"    <C-p> / <leader>ff       fichiers du projet (fzf, flou)
"    <leader>fr/fb/fh         fichiers récents / buffers / aide (fzf)
"    <leader>sw / sW          recherche floue live du mot courant (rg+fzf)
"    <leader>/                recherche floue live (motif libre)
"    <leader>sq               grep exact du mot → quickfix
"    <leader>bd / <leader>bo  supprimer le buffer / tous les autres
"    gcc / gc{motion}         commenter / décommenter (vim-commentary)
"    ys / cs / ds             entourer / changer / supprimer (vim-surround)
"    <leader>sw               chercher le mot courant dans le projet (rg)
"    <leader>/                chercher un motif dans le projet (rg)
"    <Esc><Esc>               désactiver le surlignage de recherche
"    <leader>ul ou <leader>l  afficher les invisibles (tabs, EOL)
"    <leader>uw               toggle wrap
"    jk                       retour au mode normal (insertion / terminal)
"    <C-s>                    sauvegarder
"    <A-j> / <A-k>            déplacer ligne/sélection vers le bas/haut
" ============================================================================

" ─── Initialisation ────────────────────────────────────────────────────────
set nocompatible
set encoding=utf-8
scriptencoding utf-8

" Leader = Espace (LazyVim-style). Doit être défini AVANT les plugins.
let g:mapleader = " "
let mapleader = " "

" jk → mode normal (défini tôt, comme dans ta config d'origine)
inoremap jk <Esc>
if has('terminal')
  tnoremap jk <C-\><C-n>
endif

" ─── Plugins (vim-plug) — équivalents « core » de LazyVim ─────────────────
call plug#begin('~/.vim/plugged')

  Plug 'catppuccin/vim', { 'as': 'catppuccin', 'branch': 'main' }  " colorscheme
  Plug 'vim-airline/vim-airline'
  Plug 'preservim/nerdtree',      { 'on': ['NERDTreeToggle', 'NERDTreeFind'] }
  Plug 'liuchengxu/vim-which-key' " menus <leader> (chargé au démarrage pour l'enregistrement)
  Plug 'tpope/vim-commentary'     " ≈ mini.comment        : gcc, gc{motion}
  Plug 'tpope/vim-surround'       " ≈ mini.surround       : ys, cs, ds
  Plug 'tpope/vim-repeat'         " . rejoue aussi surround/commentary
  Plug 'tpope/vim-abolish'        " ≈ remplaçements malins : crs/crm/crc
  Plug 'tpope/vim-unimpaired'     " ≈ ]b [b ]q [q ]t [t (navigation)
  Plug 'inkarkat/vim-ReplaceWithRegister' " ≈ gra/gr{motion} (remplacer par registre)
  Plug 'thinca/vim-visualstar'    " * sur une sélection visuelle
  Plug 'machakann/vim-highlightedyank' " surlignage du yank (feedback visuel)
  Plug 'junegunn/fzf'             " fournit fzf#run (le binaire fzf est déjà dans ton PATH)
  Plug 'junegunn/fzf.vim'         " ≈ Telescope : fichiers/buffers/grep flous
  Plug 'airblade/vim-rooter'      " cwd = racine du projet (comme LazyVim)
call plug#end()

filetype plugin indent on
syntax on

" matchit : % saute entre if/endif, <div>/</div>… (≈ mini.ai de LazyVim)
if has('packages')
  silent! packadd matchit
endif

