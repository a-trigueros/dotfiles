set splitbelow                 " ≈ LazyVim : nouveaux splits en bas
set splitright                 " ≈ LazyVim : nouveaux splits à droite
set pumheight=10
set cursorline
set fillchars=vert:│,fold:·,eob:~
set visualbell

" ─── Édition (conserve TES réglages d'indentation : 2 espaces) ────────────
set expandtab
set shiftwidth=2
set tabstop=2
set softtabstop=2
set smartindent
set formatoptions=tcqrn1       " conservé de ta config
set textwidth=79               " conservé de ta config

" ─── Fichiers / buffers ───────────────────────────────────────────────────
