{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agents/AGENTS.md"
  ],
  "provider": {
    "bifrost": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bifrost",
      "options": {
        "baseURL": "http://127.0.0.1:16000/v1",
        "apiKey": "{file:~/.config/opencode/bifrost-vk}",
        "modelsDiscovery": {
          "enabled": true
        }
      }
    }
  },
  "mcp": {
    "bifrost": {
      "type": "remote",
      "url": "http://localhost:16000/mcp",
      "headers": {
        "x-bf-vk": "{file:~/.config/opencode/bifrost-vk}"
      }
    },
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--project-from-cwd"
      ]
    }
  },
  "plugin": [
    "opencode-models-discovery",
    "@dietrichgebert/ponytail"
  ]
}
