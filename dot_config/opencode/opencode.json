{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agents/AGENTS.md"
  ],
  "provider": {
    "bifrost": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bifrost",
      "options": {
        "baseURL": "http://127.0.0.1:16000/v1",
        "apiKey": "{file:~/.config/opencode/bifrost-vk}",
        "modelsDiscovery": {
          "enabled": true
        }
      },
      "models": {
        "zai/glm-4.5": {
          "limit": {
            "context": 131072,
            "output": 98304
          }
        },
        "zai/glm-4.5-air": {
          "limit": {
            "context": 131072,
            "output": 98304
          }
        },
        "zai/glm-4.6": {
          "limit": {
            "context": 204800,
            "output": 131072
          }
        },
        "zai/glm-4.7": {
          "limit": {
            "context": 204800,
            "output": 131072
          }
        },
        "zai/glm-5": {
          "limit": {
            "context": 204800,
            "output": 131072
          }
        },
        "zai/glm-5-turbo": {
          "limit": {
            "context": 202752,
            "output": 131072
          }
        },
        "zai/glm-5.1": {
          "limit": {
            "context": 204800,
            "output": 128000
          }
        },
        "zai/glm-5.2": {
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "zai/glm-5.3": {
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "zai/glm-5.3-flash": {
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        },
        "zai/glm-5.3-flashx": {
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "bifrost": {
        "type": "remote",
        "url": "http://localhost:16000/mcp",
        "headers": {
          "x-bf-vk": "{file:~/.config/opencode/bifrost-vk}"
        }
      }
    }
  },
  "plugin": [
    "opencode-models-discovery",
    "@dietrichgebert/ponytail"
  ]
}
