{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "U5KxKezplSHqyXVoFHH9bTDu47KYjn+cZCKNgcx+YSg=",
  "setup_token": "env.BIFROST_BOOTSTRAP",
  "client": {
    "drop_excess_requests": false,
    "enable_logging": true,
    "allowed_headers": [
      "*"
    ]
  },
  "providers": {
    "zai": {
      "keys": [
        {
          "name": "zai-coding-plan",
          "value": "env.ZAI_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://api.z.ai/api/anthropic",
        "default_request_timeout_in_seconds": 300
      },
      "custom_provider_config": {
        "base_provider_type": "anthropic"
      }
    }
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "{{ .chezmoi.homeDir }}/.config/bifrost/config.db"
    }
  },
  "mcp": {
    "tool_manager_config": {
      "disable_auto_tool_inject": true
    },
    "client_configs": [
      {
        "name": "context7",
        "connection_type": "stdio",
        "stdio_config": {
          "command": "context7-mcp"
        },
        "tools_to_execute": [
          "*"
        ],
        "allow_on_all_virtual_keys": true
      },
      {
        "name": "deepwiki",
        "connection_type": "http",
        "connection_string": "https://mcp.deepwiki.com/mcp",
        "tools_to_execute": [
          "*"
        ],
        "allow_on_all_virtual_keys": true
      },
      {
        "name": "obsidian_brain",
        "connection_type": "stdio",
        "stdio_config": {
          "command": "obsidian-brain",
          "args": [
            "server"
          ]
        },
        "tools_to_execute": [
          "*"
        ],
        "allow_on_all_virtual_keys": true
      },
      {
        "name": "zai_web_search_sse",
        "connection_type": "sse",
        "connection_string": "env.ZAI_MCP_URL",
        "tools_to_execute": [
          "*"
        ],
        "allow_on_all_virtual_keys": true
      }
    ]
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "vk-pi",
        "name": "pi",
        "value": "env.BIFROST_VKEY_PI",
        "allow_all_providers": true,
        "is_active": true
      },
      {
        "id": "vk-opencode",
        "name": "opencode",
        "value": "env.BIFROST_VKEY_OPENCODE",
        "allow_all_providers": true,
        "is_active": true
      },
      {
        "id": "vk-goose",
        "name": "goose",
        "value": "env.BIFROST_VKEY_GOOSE",
        "allow_all_providers": true,
        "is_active": true
      }
    ]
  }
}
